---
import Img from "./Img.astro";
import Button from "./Button.astro";
import logo from "../assets/logo_with_title.svg";
import { withBase } from "../utils/url";
---

<nav class="grid grid-cols-[1fr_auto_1fr] w-full items-center px-6 py-4 bg-black/1 border-b border-gray-200 sticky">
  <a href={withBase("/")}>
    <Img src={logo} height={48} />
  </a>
  <div class="pl-6 grid grid-cols-[1fr_auto_1fr] justify-center gap-12">
    <a href={withBase("/about")} class="text-right">
      About
    </a>
    <a href={withBase("/blog")} class="text-center">
      Blog
    </a>
    <a href={withBase("/resources")} class="text-left">
      Resources
    </a>
  </div>
  <div class="flex items-center justify-self-end gap-8">
    <a href={withBase("/contact")}>Contact</a>
    <Button href={withBase("/signup")}>Join us!</Button>
  </div>
</nav>
